NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side only. Never use the service role key in a NEXT_PUBLIC_* variable.

# Optional: enables AI narration only (server-side only).
OPENAI_API_KEY=

# Required for administration and question imports (server-side only).
# Student question replacement uses approved reserves and does not need OpenAI.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=

# Gerar campos: configure one or more free providers. Never use NEXT_PUBLIC_*.
# *_FREE_TIER_CONFIRMED is an operator assertion, not an API billing check.
# Set true ONLY for free accounts/projects with paid billing disabled.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false
# Always uses openrouter/free; no paid model fallback.
OPENROUTER_API_KEY=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_FREE_TIER_CONFIRMED=false
# Local ceilings per provider, shared across all administrators/instances.
# Actual provider quotas (including token limits) may be lower.
TEACHING_PROVIDER_DAILY_LIMIT=100
TEACHING_PROVIDER_MINUTE_LIMIT=2
