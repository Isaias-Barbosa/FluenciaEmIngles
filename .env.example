NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side only. Never use the service role key in a NEXT_PUBLIC_* variable.

# Optional: enables AI narration for listening exercises (server-side only).
OPENAI_API_KEY=

# Required for authenticated web question search + persistence (server-side only).
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Must support Responses web_search + JSON schema.
OPENAI_WEB_QUESTION_MODEL=gpt-5.4-mini
